{
  "skillId": "learning_phase_diagnosis",
  "version": "0.1",
  "note": "3 个离线 case，用于人工/LLM 评测；不是线上 A/B。",
  "cases": [
    {
      "id": "lp-001",
      "name": "学习期低 ROI，样本足够",
      "input": {
        "accountId": "acc_demo_001",
        "planId": "plan_demo_001",
        "planName": "标准-轻透防晒霜-直播间引流",
        "learningDay": 5,
        "roi7d": 2.8,
        "roiGoal": 3.5,
        "conversionsPerDay": 30,
        "costShare": 0.32,
        "stockDays": 20,
        "balanceDays": 5,
        "dataLagMinutes": 12,
        "partialAuth": false
      },
      "expected": {
        "verdict": "reduce",
        "mustInclude": [
          {
            "label": "学习期",
            "any": [
              "学习期",
              "学习第5天"
            ]
          },
          {
            "label": "预算 -10%",
            "any": [
              "预算 -10%",
              "budget -10%",
              "预算降低10%"
            ]
          }
        ],
        "mustNotInclude": [
          "暂停计划",
          "加预算"
        ],
        "guardrail": [
          "GMV ≥ -5%",
          "库存 ≥7 天"
        ]
      }
    },
