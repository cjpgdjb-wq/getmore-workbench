{
  "skillId": "inventory_stop_loss",
  "version": "0.1",
  "note": "5 个库存止损 case；不是线上 A/B。",
  "cases": [
    {
      "id": "is-001",
      "name": "库存 2 天 + 计划仍在投放",
      "input": {
        "accountId": "acc_inv_1",
        "accountName": "沐野运动旗舰店",
        "planId": "plan_inv_1",
        "planName": "标准-轻量徒步鞋-短视频带货",
        "planStatus": "投放中",
        "cost7d": 28000,
        "roi7d": 3.6,
        "productName": "轻量徒步鞋",
        "productStatus": "在售",
        "stock": 60,
        "stockDays": 2,
        "ordersPerDay": 30,
        "dataLagMinutes": 10
      },
      "expected": {
        "verdict": "pause",
        "mustInclude": [
          {
            "label": "库存",
            "any": [
              "库存",
              "2 天",
              "2天"
            ]
          }
        ],
        "actionAny": [
          "pause",
          "暂停"
        ],
        "mustNotInclude": [
          "加预算",
          "+10%"
        ],
        "guardrail": [
          "暂停可回滚"
        ]
      }
    },
    {
      "id": "is-002",
      "name": "库存 5 天 + 计划仍在投放",
      "input": {
        "accountId": "acc_inv_2",
        "accountName": "简味食品旗舰店",
        "planId": "plan_inv_2",
        "planName": "全域-每日坚果礼盒-短视频带货",
        "planStatus": "投放中",
        "cost7d": 22000,
        "roi7d": 4.1,
        "productName": "每日坚果礼盒",
        "productStatus": "在售",
        "stock": 150,
        "stockDays": 5,
        "ordersPerDay": 30,
        "dataLagMinutes": 8
      },
      "expected": {
        "verdict": "reduce",
        "mustInclude": [
          {
            "label": "库存",
            "any": [
              "库存",
              "5 天",
              "5天"
            ]
          }
        ],
        "actionAny": [
          "reduce",
          "budget",
          "-20%",
          "降 20%",
          "降预算"
        ],
        "mustNotInclude": [
          "加预算",
          "+10%"
        ],
        "guardrail": [
          "不直接暂停"
        ]
      }
    },
    {
      "id": "is-003",
      "name": "库存充足",
      "input": {
        "accountId": "acc_inv_3",
        "accountName": "初见美妆旗舰店",
        "planId": "plan_inv_3",
        "planName": "标准-玻尿酸保湿精华-短视频带货",
        "planStatus": "投放中",
        "cost7d": 18000,
        "roi7d": 4.7,
        "productName": "玻尿酸保湿精华",
        "productStatus": "在售",
        "stock": 1200,
        "stockDays": 30,
        "ordersPerDay": 40,
        "dataLagMinutes": 9
      },
      "expected": {
        "verdict": "observe",
        "mustInclude": [
          {
            "label": "库存充足",
            "any": [
              "库存",
              "30 天",
              "30天"
            ]
          }
        ],
        "actionAny": [
          "observe",
          "只观察"
        ],
        "mustNotInclude": [
          "暂停",
          "降预算"
        ],
        "guardrail": [
          "不提交动作"
        ]
      }
    },
    {
      "id": "is-004",
      "name": "低库存但计划已暂停",
      "input": {
        "accountId": "acc_inv_4",
        "accountName": "花间集旗舰店",
